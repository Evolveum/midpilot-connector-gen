APP__TITLE="Midpilot Connector Generator (DEV)"
APP__LIVE_RELOAD=true

APP__WORKERS=1
JOBS__ENABLED=true
JOBS__MAX_CONCURRENT_JOBS=2
JOBS__POLL_INTERVAL_SECONDS=0.5
JOBS__REAPER_INTERVAL_SECONDS=30
JOBS__CLAIM_TIMEOUT_SECONDS=300
JOBS__HEARTBEAT_INTERVAL_SECONDS=30
JOBS__MAX_ATTEMPTS=3
JOBS__SHUTDOWN_GRACE_SECONDS=10
JOBS__CLAIM_RELEASE_TIMEOUT_SECONDS=3
JOBS__DOCUMENTATION_WRITE_BATCH_SIZE=20
JOBS__CPU_PROCESSES=1

# API key authentication
# Development mode: no API key required (default).
# Production mode: set AUTH__API_KEY_REQUIRED=true and configure a master key;
# the master key accesses everything and is the only key allowed to manage
# (issue/revoke) API keys via the /apiKeys endpoints.
AUTH__API_KEY_REQUIRED=false
#AUTH__MASTER_API_KEY=change-me-long-random-secret
LOGGING__LEVEL=info
LOGGING__COLORS=true

# llm
LLM__OPENAI_API_KEY=my_api_key
# LLM__MODEL_NAME=openai/gpt-oss-120b
#LLM__OPENAI_API_BASE=https://openrouter.ai/api/v1
#LLM__CA_CERT_FILE=/path/to/cert
#LLM__REASONING_EFFORT=high # Possible values: low, medium, high based on the LLM provider's capabilities.

# digester
# This remains process-local: 4 APP__WORKERS with the default 10 may issue up
# to 40 concurrent digester LLM calls.
#DIGESTER__MAX_CONCURRENT_LLM_CALLS=10

# langfuse configuration
#LANGFUSE__HOST=langfuse-host
#LANGFUSE__SECRET_KEY=langfusehost-secret-key
#LANGFUSE__PUBLIC_KEY=langfusehost-public-key
#LANGFUSE__TRACING_ENABLED=true
#LANGFUSE__ENVIRONMENT=dev-myname
#LANGFUSE__CA_CERT_FILE=/path/to/cert


# search method
SEARCH__METHOD_NAME=methodname #  either "ddgs" or "brave"

# brave configuration
BRAVE__API_KEY=mybravekey
BRAVE__ENDPOINT=myendpoint

# DATABASE CONFIGURATION
DATABASE__HOST=localhost # for local deployment
# DATABASE__HOST=db # for docker deployment
DATABASE__INT_PORT=5432
DATABASE__EXT_PORT=5433
DATABASE__NAME=db_name
DATABASE__USER=user
DATABASE__PASSWORD=password

# Full database URL (used by Python/SQLAlchemy)
DATABASE__URL=postgresql+asyncpg://${DATABASE__USER}:${DATABASE__PASSWORD}@${DATABASE__HOST}:${DATABASE__EXT_PORT}/${DATABASE__NAME}

# Database used by test/integration/database. Each test creates and drops its own schema in it,
# so point this at a disposable database. When unset, those tests report as skipped.
TEST_DATABASE_URL=${DATABASE__URL}
