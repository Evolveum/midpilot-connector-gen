# Ignore environment variable files
.env*
**/.env*
*.env

# Ignore Python virtual environments
.venv/
venv/

# Ignore cache and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
build/
dist/

# Ignore git files
.git/
.gitignore

# Local tooling and credentials are not runtime assets.
.idea/
*.pem
*.key
*.p12
.pytest_cache/
.mypy_cache/
.ruff_cache/
